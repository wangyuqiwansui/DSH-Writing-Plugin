{
  "schemaVersion": "backtest-dataset-v1",
  "id": "knowledge-multi-evidence",
  "version": "1.0.0",
  "title": "多资料证据覆盖",
  "kind": "retrieval",
  "provenance": {
    "type": "synthetic",
    "reviewed": true,
    "note": "固定合成回归样本；人工整理词用于可复现对照，不代表实时模型或真实业务成绩。"
  },
  "cases": [
    {
      "id": "m1",
      "question": "夜间码头通行证由谁签发，签发机构能否审判？",
      "expected": [
        {
          "documentId": "dock",
          "quote": "商会签发的通行证"
        },
        {
          "documentId": "guild",
          "quote": "无权审判刑事案件"
        }
      ],
      "answerable": true,
      "split": "dev"
    },
    {
      "id": "m2",
      "question": "借火术和留声石有哪些限制？",
      "expected": [
        {
          "documentId": "fire",
          "quote": "不能凭空生火"
        },
        {
          "documentId": "stone",
          "quote": "只能播放一次"
        }
      ],
      "answerable": true,
      "split": "dev"
    },
    {
      "id": "m3",
      "question": "林阿是否知道凶手，旁白能否展示任意人的心理？",
      "expected": [
        {
          "documentId": "lina",
          "quote": "尚不知道仓库失火的真凶"
        },
        {
          "documentId": "style",
          "quote": "当前视角人物可感知的信息"
        }
      ],
      "answerable": true,
      "split": "test"
    },
    {
      "id": "m4",
      "question": "夜航如何辨认返港方向，居民白天通行是否收费？",
      "expected": [
        {
          "documentId": "bell",
          "quote": "钟声帮助夜航船只辨认返港方向"
        },
        {
          "documentId": "dock",
          "quote": "白天可免费通过"
        }
      ],
      "answerable": true,
      "split": "test"
    }
  ],
  "documents": [
    {
      "id": "fire",
      "title": "借火术",
      "text": "借火术只能引导视线内已有的火源，不能凭空生火。视线中断时，借火术立即停止。",
      "keywords": [
        "借火术",
        "施法",
        "魔法",
        "无火源",
        "点燃",
        "视线",
        "限制"
      ]
    },
    {
      "id": "dock",
      "title": "雾港通行",
      "text": "旧码头夜间通行需要商会签发的通行证。普通居民白天可免费通过。",
      "keywords": [
        "旧码头",
        "港口",
        "夜行",
        "入港",
        "通行证",
        "证件",
        "收费"
      ]
    },
    {
      "id": "bell",
      "title": "夜航信号",
      "text": "旧仓库的铜钟每隔一刻敲响，钟声帮助夜航船只辨认返港方向。灯塔已在风暴中损毁。",
      "keywords": [
        "导航",
        "返航",
        "黑夜",
        "航船",
        "指引",
        "铜钟",
        "灯塔"
      ]
    },
    {
      "id": "stone",
      "title": "留声石",
      "text": "留声石仅能记录声音，不能记录画面。每块留声石只能播放一次，播放结束后永久失效。",
      "keywords": [
        "录音",
        "影像",
        "回放",
        "留声石",
        "次数",
        "重复播放"
      ]
    },
    {
      "id": "lina",
      "title": "林阿章前状态",
      "text": "第一章开始前，林阿在旧码头，左臂受伤，持有一枚铜钥匙。林阿尚不知道仓库失火的真凶。",
      "keywords": [
        "主角",
        "林阿",
        "伤势",
        "物品",
        "钥匙",
        "知情",
        "凶手",
        "第一章"
      ]
    },
    {
      "id": "rumor",
      "title": "海神传闻",
      "text": "码头工人传说海神会在月圆之夜收走船只。这只是传闻，作者尚未确认海神存在。",
      "keywords": [
        "神明",
        "海神",
        "月圆",
        "真伪",
        "传闻",
        "事实"
      ]
    },
    {
      "id": "guild",
      "title": "渡口商会",
      "text": "渡口商会负责签发夜间通行证，无权审判刑事案件。商会的会长由五名船主投票选出。",
      "keywords": [
        "商会",
        "权限",
        "审判",
        "选举",
        "会长",
        "通行证"
      ]
    },
    {
      "id": "style",
      "title": "叙述风格",
      "text": "本书使用第三人称限知视角，叙述仅展示当前视角人物可感知的信息。对话应简短，避免直接解释人物心理。",
      "keywords": [
        "文风",
        "人称",
        "视角",
        "旁白",
        "全知",
        "对白",
        "心理"
      ]
    }
  ],
  "config": {
    "topK": 3,
    "maxCharacters": 12000,
    "representations": [
      "literal",
      "lexical",
      "enriched"
    ]
  }
